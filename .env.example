# Copy to .env (never commit .env). Used by docker-compose and when running the backend locally.
DB_USER=careerpilot
DB_PASSWORD=careerpilot
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
# Optional: without a key the AI pages use a clearly-labelled rule-based fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
